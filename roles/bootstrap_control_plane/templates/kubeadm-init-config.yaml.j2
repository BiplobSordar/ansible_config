# {{ ansible_managed }}

###############################################################################
# kubeadm Cluster Initialization Configuration
#
# Generated by Ansible
#
# This file is rendered only on the FIRST control-plane node.
#
# Architecture
#
# Terraform
#        │
#        ▼
# Internal Kubernetes API NLB
#        │
#        ▼
# Control Plane 1
# Control Plane 2
# Control Plane 3
#
# Every future control-plane joins through:
#
# controlPlaneEndpoint
#
###############################################################################

---
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration

localAPIEndpoint:

  advertiseAddress: "{{ ansible_default_ipv4.address }}"

  bindPort: {{ control_plane_endpoint_port }}

nodeRegistration:

  name: "{{ node_name | default(inventory_hostname) }}"

  criSocket: unix:///run/containerd/containerd.sock

  kubeletExtraArgs:

    node-ip: "{{ ansible_default_ipv4.address }}"

---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration

clusterName: "{{ cluster_name }}"

kubernetesVersion: "v{{ kubernetes_version }}"

###############################################################################
# THIS MUST POINT TO THE INTERNAL NLB CREATED BY TERRAFORM
###############################################################################

controlPlaneEndpoint: "{{ control_plane_endpoint }}:{{ control_plane_endpoint_port }}"

networking:

  podSubnet: "{{ pod_network_cidr }}"

  serviceSubnet: "{{ service_cidr }}"

dns: {}

apiServer: {}

controllerManager: {}

scheduler: {}

etcd:

  local:

    dataDir: /var/lib/etcd

---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration

cgroupDriver: systemd

failSwapOn: true

---
apiVersion: kubeproxy.config.k8s.io/v1alpha1
kind: KubeProxyConfiguration

mode: iptables