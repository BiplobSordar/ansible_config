
namespaceOverride: monitoring

grafana:
  enabled: true

  adminPassword: admin123

  persistence:
    enabled: true
    size: 10Gi

prometheus:
  prometheusSpec:
    retention: 15d

    resources:
      requests:
        cpu: 500m
        memory: 1Gi

      limits:
        cpu: 1000m
        memory: 2Gi

alertmanager:
  enabled: true

nodeExporter:
  enabled: true

kubeStateMetrics:
  enabled: true